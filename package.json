{
  "name": "lol-drafter",
  "version": "1.0.0",
  "description": "Tool for analize and help choosing champions in League of Legends",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "nodemon server.js --ignore client/",
    "start:prod": "set NODE_ENV=production&&nodemon server.js",
    "client": "vite --config vite.config.js",
    "fullstack": "concurrently \"npm run start\" \"npm run client\"",
    "worker": "node ./worker.js"
  },
  "author": "Kuantik Software",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.5",
    "puppeteer": "^24.10.2",
    "qs": "^6.14.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.5.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
